generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Comercio {
  id_comercio         String   @id @default(uuid()) @db.Uuid
  nombre_comercio     String   @db.VarChar(150)
  nit_identificacion  String   @unique @db.VarChar(50)
  estado_activo       Boolean  @default(true)
  fecha_registro      DateTime @default(now()) @db.Timestamptz
  fecha_actualizacion DateTime @default(now()) @updatedAt @db.Timestamptz

  usuarios         Usuario[]
  transacciones    Transaccion[]
  conexiones_gmail ConexionGmail[]
  alertas_email    AlertaEmail[]
  numeros_whatsapp NumeroWhatsApp[]

  @@map("Comercios")
}

enum Rol {
  CAJERO
  ADMINISTRADOR
}

model Usuario {
  id_usuario             String    @id @default(uuid()) @db.Uuid
  id_comercio            String    @db.Uuid
  email                  String    @unique @db.VarChar(150)
  nombre_completo        String    @db.VarChar(150)
  rol                    Rol
  password_hash          String    @db.VarChar(255)
  reset_password_token   String?   @db.VarChar(255)
  reset_password_expires DateTime? @db.Timestamptz
  fecha_registro         DateTime  @default(now()) @db.Timestamptz

  comercio      Comercio      @relation(fields: [id_comercio], references: [id_comercio])
  transacciones Transaccion[]

  @@map("Usuarios")
}

enum Banco {
  NEQUI
  BANCOLOMBIA
  OTROS_BANCOS
}

enum CanalIngreso {
  WEB
  WHATSAPP
}

enum EstadoTransaccion {
  SUBIDO_SIN_VERIFICAR
  VERIFICADO_MANUAL
  RECHAZADO
  DUPLICADO_SOSPECHOSO
  VERIFICADO_SISTEMA
}

enum EstadoAlertaEmail {
  PENDIENTE
  CONCILIADO
  ERROR_PARSEO
}

model Transaccion {
  id_transaccion       String            @id @default(uuid()) @db.Uuid
  id_comercio          String            @db.Uuid
  id_usuario_creador   String?           @db.Uuid
  banco                Banco
  monto                Decimal?          @db.Decimal(12, 2)
  referencia           String?           @db.VarChar(100)
  nombre_remitente_ocr String?           @db.VarChar(150)
  fecha_transaccion    DateTime?         @db.Timestamptz
  url_imagen_gcs       String            @db.Text
  canal_ingreso        CanalIngreso
  numero_whatsapp_origen String?         @db.VarChar(20)
  estado               EstadoTransaccion
  metadata_ocr         Json?             @db.JsonB
  notas_revision       String?           @db.Text
  fecha_creacion       DateTime          @default(now()) @db.Timestamptz
  fecha_actualizacion  DateTime          @default(now()) @updatedAt @db.Timestamptz
  duplicado_de_id      String?           @db.Uuid
  id_alerta_email      String?           @db.Uuid

  comercio     Comercio      @relation(fields: [id_comercio], references: [id_comercio])
  creador      Usuario?      @relation(fields: [id_usuario_creador], references: [id_usuario])
  duplicado_de Transaccion?  @relation("Duplicados", fields: [duplicado_de_id], references: [id_transaccion])
  duplicados   Transaccion[] @relation("Duplicados")
  alerta_email AlertaEmail?  @relation(fields: [id_alerta_email], references: [id_alerta])

  @@index([id_comercio, fecha_creacion(sort: Desc)])
  @@index([id_comercio, estado])
  @@index([id_comercio, referencia])
  @@map("Transacciones")
}

model ConexionGmail {
  id_conexion            String    @id @default(uuid()) @db.Uuid
  id_comercio            String    @db.Uuid
  email_conectado        String    @unique @db.VarChar(150)
  refresh_token          String    @db.Text
  access_token           String?   @db.Text
  gmail_history_id       String?   @db.VarChar(255)
  gmail_watch_expires_at DateTime? @db.Timestamptz
  fecha_creacion         DateTime  @default(now()) @db.Timestamptz
  estado                 Boolean   @default(true)

  comercio Comercio @relation(fields: [id_comercio], references: [id_comercio])

  @@map("ConexionesGmail")
}

model AlertaEmail {
  id_alerta              String            @id @default(uuid()) @db.Uuid
  id_comercio            String            @db.Uuid
  banco                  Banco
  monto                  Decimal           @db.Decimal(12, 2)
  referencia             String?           @db.VarChar(100)
  nombre_remitente       String?           @db.VarChar(150)
  remitente_original     String?           @db.VarChar(255)
  asunto                 String?           @db.VarChar(255)
  fecha_hora_transaccion DateTime          @db.Timestamptz
  fecha_alerta           DateTime          @db.Timestamptz
  email_message_id       String            @unique @db.VarChar(255)
  html_original          String            @db.Text
  estado_cruce           EstadoAlertaEmail @default(PENDIENTE)
  fecha_creacion         DateTime          @default(now()) @db.Timestamptz

  comercio      Comercio      @relation(fields: [id_comercio], references: [id_comercio])
  transacciones Transaccion[]

  @@index([id_comercio, referencia])
  @@map("AlertasEmail")
}

model NumeroWhatsApp {
  id_numero      String   @id @default(uuid()) @db.Uuid
  id_comercio    String   @db.Uuid
  numero         String   @unique @db.VarChar(20)
  etiqueta       String?  @db.VarChar(100)
  fecha_registro DateTime @default(now()) @db.Timestamptz

  comercio Comercio @relation(fields: [id_comercio], references: [id_comercio], onDelete: Cascade)

  @@index([id_comercio])
  @@map("NumerosWhatsApp")
}

model LogAuditoria {
  id             String   @id @default(uuid()) @db.Uuid
  id_comercio    String   @db.Uuid
  id_usuario     String   @db.Uuid
  nombre_usuario String   @db.VarChar(150)
  rol_usuario    String   @db.VarChar(50)
  accion         String   @db.VarChar(100)
  id_transaccion String?  @db.Uuid
  detalles       String   @db.Text
  created_at     DateTime @default(now()) @db.Timestamptz

  @@index([id_comercio, created_at(sort: Desc)])
  @@map("LogsAuditoria")
}
